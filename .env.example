SECRET_KEY=change-me-generate-a-real-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Google OAuth — create a Web OAuth Client ID in Google Cloud Console
# (Authorized JS origin: http://localhost:5173, redirect not needed for the
# One Tap / GIS token flow used here).
GOOGLE_OAUTH_CLIENT_ID=

# Paystack — use TEST keys during development (https://dashboard.paystack.com)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Email (leave EMAIL_BACKEND as console for local dev — reset links print to terminal)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@coopsys.local

FRONTEND_URL=http://localhost:5173

LOGIN_ATTEMPT_LIMIT=5
LOGIN_ATTEMPT_LOCKOUT_SECONDS=300
